<comment>
problem   = sf benchmark

<job>
basename  = sfb

<mesh>
nghost    = 2
nx1       = 256
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 256
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 256
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 64
nx2       = 64
nx3       = 64

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 3.0

<hydro>
eos         = isothermal
iso_sound_speed = 1.0
reconstruct = plm
rsolver     = hlle

<problem>
noise     = 0.0
constant  = false

<turb_driving>
type  = hydro
tcorr = 0.5
dedt  = 1.0
nlow  = 1
nhigh = 2

<output1>
file_type  = rst
dt         = 1.0

<output2>
file_type  = spec
id         = v
mode       = helmholtz
variables  = hydro_w_vx, hydro_w_vy, hydro_w_vz
nbin       = 128
dt         = 0.5

<output3>
file_type      = sf
id             = scalar_b16
mode           = scalar
variables      = hydro_w_vx, hydro_w_vy, hydro_w_vz
weights        = ones, hydro_w_d
max_order      = 10
nbin           = 64
ndraw_block    = 4096
nsample_global = 4096
nanchor_global = 65536
nreplicate     = 8
seed           = 11
timing         = true
dt             = 0.5

<output4>
file_type      = sf
id             = long_trans_b16
mode           = long_trans
variables      = hydro_w_vx, hydro_w_vy, hydro_w_vz
weights        = ones, hydro_w_d
max_order      = 10
nbin           = 64
ndraw_block    = 4096
nsample_global = 4096
nanchor_global = 65536
nreplicate     = 8
seed           = 11
timing         = true
dt             = 0.5

<output5>
file_type      = sf
id             = scalar_b4
mode           = scalar
variables      = hydro_w_vx, hydro_w_vy, hydro_w_vz
weights        = ones, hydro_w_d
max_order      = 10
nbin           = 64
ndraw_block    = 16384
nsample_global = 16384
nanchor_global = 262144
nreplicate     = 8
seed           = 11
timing         = true
dt             = 0.5

<output6>
file_type      = sf
id             = long_trans_b4
mode           = long_trans
variables      = hydro_w_vx, hydro_w_vy, hydro_w_vz
weights        = ones, hydro_w_d
max_order      = 10
nbin           = 64
ndraw_block    = 16384
nsample_global = 16384
nanchor_global = 262144
nreplicate     = 8
seed           = 11
timing         = true
dt             = 0.5

<output7>
file_type      = sf
id             = scalar_b1
mode           = scalar
variables      = hydro_w_vx, hydro_w_vy, hydro_w_vz
weights        = ones, hydro_w_d
max_order      = 10
nbin           = 64
ndraw_block    = 65536
nsample_global = 65536
nanchor_global = 1048576
nreplicate     = 8
seed           = 11
timing         = true
dt             = 0.5

<output8>
file_type      = sf
id             = long_trans_b1
mode           = long_trans
variables      = hydro_w_vx, hydro_w_vy, hydro_w_vz
weights        = ones, hydro_w_d
max_order      = 10
nbin           = 64
