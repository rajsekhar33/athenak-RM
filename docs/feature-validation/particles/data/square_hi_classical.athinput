# AthenaK input file for high-statistics classical tracers in the square-wave test

<comment>
problem   = Classical Lagrangian tracer square wave high-statistics run

<job>
basename  = ClassicalSquareHi

<mesh>
nghost    = 3
nx1       = 128
x1min     = -0.5
x1max     = 0.5
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 128
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 4
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 128
nx2       = 32
nx3       = 4

<time>
evolution  = kinematic
integrator = rk2
cfl_number = 0.2
nlim       = 100000
tlim       = 3.0
ndiag      = 20

<hydro>
eos         = isothermal
reconstruct = ppmx
rsolver     = advect
iso_sound_speed = 1.0

<problem>
pgen_name   = advection
advect_dens = true
flow_dir    = 1
iproblem    = 2
velocity    = 1.0
amplitude   = 1.0

<particles>
particle_type    = lagrangian_mc
target_count     = 1310720
pusher           = classical
pos_init_seed    = 280496
random_positions = true

<output1>
file_type = bin
variable  = hydro_w
dt        = 1.0

<output2>
file_type = pbin
variable  = hydro_w
dt        = 1.0

<output3>
file_type = rst
dt        = 1.0
dt_wall   = 600

<output4>
file_type = prst
dt        = 1.0
dt_wall   = 600
