<job>
basename = cflow

<mesh>
nghost = 3
nx1 = 128
x1min = -0.5
x1max = 0.5
ix1_bc = outflow
ox1_bc = outflow
nx2 = 4
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 4
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 128
nx2 = 4
nx3 = 4

<time>
evolution = kinematic
integrator = rk2
cfl_number = 0.2
nlim = -1
tlim = 0.3
ndiag = 20

<hydro>
eos = isothermal
reconstruct = ppmx
rsolver = advect
iso_sound_speed = 1.0

<problem>
pgen_name = none
strain_rate = 1.0
amplitude = 0.2

<particles>
particle_type = lagrangian_tracer
target_count = 655360
pusher = ito_2
pos_init_seed = 42
random_positions = true

<output1>
file_type = bin
variable = hydro_w
dt = 0.3

<output2>
file_type = pbin
variable = hydro_w
dt = 0.3
