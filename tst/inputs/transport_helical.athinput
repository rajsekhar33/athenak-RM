<job>
basename = helix
<units>
length_cgs = 1.0
mass_cgs = 1.0
time_cgs = 1.0
mu = 1.0
<mesh>
nghost = 2
nx1 = 16
nx2 = 16
nx3 = 16
x1min = 0.0
x1max = 1.0
x2min = 0.0
x2max = 1.0
x3min = 0.0
x3max = 1.0
ix1_bc = periodic
ox1_bc = periodic
ix2_bc = periodic
ox2_bc = periodic
ix3_bc = periodic
ox3_bc = periodic
<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16
<time>
evolution = kinematic
integrator = rk2
cfl_number = 0.4
tlim = 0.02
nlim = -1
ndiag = 1000
sts_integrator = none
<mhd>
anisotropic_limiter = vanleer
eos = ideal
gamma = 2.0
reconstruct = plm
rsolver = advect
alpha_iso = 0.0
alpha_aniso = 0.1
alpha_spitzer = false
q_limit = 3.4028234663852886e38
conductivity_integrator = explicit
dfloor = 1.e-12
pfloor = 1.e-12
tfloor = 1.e-12
<problem>
pgen_name = transport_mode
profile = helical
angular_mode = 1
axial_mode = 1
field_sign = 1
stage_probe_negative = false
<output1>
file_type = bin
variable = mhd_w
dt = 0.02
<output2>
file_type = rst
dt = 0.01
<output3>
file_type = log
dt = 0.02
