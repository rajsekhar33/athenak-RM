# AthenaK input file for the Hydro first-order flux correction GPU regression

<comment>
problem   = hydro linear wave with first-order flux correction
reference = Stone et al, ApJS 178, 137 (2008), sect 8.1

<job>
basename = hydro_fofc

<mesh>
nghost = 3
nx1    = 64
x1min  = 0.0
x1max  = 3.0
ix1_bc = periodic
ox1_bc = periodic

nx2    = 32
x2min  = 0.0
x2max  = 1.5
ix2_bc = periodic
ox2_bc = periodic

nx3    = 32
x3min  = 0.0
x3max  = 1.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<mesh_refinement>
refinement = none

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 4
tlim       = 1.0
ndiag      = 1

<hydro>
eos             = ideal
reconstruct     = plm
rsolver         = hllc
gamma           = 1.66666666667
iso_sound_speed = 1.0
fofc            = true

<problem>
pgen_name = linear_wave
wave_flag = 0
amp       = 1.0e-3
dens      = 1.0
pgas      = 0.6
vx0       = 0.0
along_x1  = false
along_x2  = false
along_x3  = false
