# `dt_wall` is the sole trigger in this short, backend-independent smoke test.

<job>
basename = PublicDtWall

<mesh>
nghost = 2
nx1 = 8
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 4
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 4
nx2 = 4
nx3 = 4

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
nlim = 6
tlim = 1.0
ndiag = 1

<hydro>
eos = ideal
reconstruct = plm
rsolver = llf
gamma = 1.4

<problem>
pgen_name = hook_test
dens = 1.0
pres = 1.0

<output1>
file_type = tab
variable = hydro_w_d
data_format = %12.5e
dt_wall = 1.0e-6
slice_x2 = 0.0
slice_x3 = 0.0
