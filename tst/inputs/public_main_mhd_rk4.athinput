# Multidimensional MHD linear wave for the public-main RK4 register regression.

<job>
basename = PublicMhdRk4

<mesh>
nghost = 2
nx1 = 16
x1min = 0.0
x1max = 3.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = 0.0
x2max = 1.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = 0.0
x3max = 1.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 4
nx2 = 4
nx3 = 4

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.3
nlim = -1
tlim = 1.0
ndiag = 1

<mhd>
eos = ideal
reconstruct = plm
rsolver = llf
gamma = 1.6666666666666667

<problem>
pgen_name = linear_wave
wave_flag = 0
amp = 1.0e-6
dens = 1.0
pgas = 0.6
vx0 = 0.0
vy0 = 0.0
vz0 = 0.0
bx0 = 1.0
by0 = 1.4142136
bz0 = 0.5
along_x1 = false
along_x2 = false
along_x3 = false
