<job>
basename = patch
<mesh>
nghost = 2
nx1 = 32
nx2 = 32
nx3 = 1
x1min = -1.0
x1max = 1.0
x2min = -1.0
x2max = 1.0
x3min = 0.0
x3max = 1.0
ix1_bc = periodic
ox1_bc = periodic
ix2_bc = periodic
ox2_bc = periodic
<meshblock>
nx1 = 16
nx2 = 16
<time>
evolution = kinematic
integrator = rk2
cfl_number = 0.4
tlim = 0.2
nlim = -1
ndiag = 1000
sts_integrator = none
<mhd>
eos = ideal
gamma = 2.0
reconstruct = plm
rsolver = advect
alpha_iso = 0.0
alpha_aniso = 0.1
anisotropic_limiter = vanleer
conductivity_integrator = explicit
dfloor = 1.e-12
pfloor = 1.e-12
tfloor = 1.e-12
<problem>
pgen_name = transport_mode
profile = square
user_work_in_loop = true
cold = 0.1
hot = 10.0
bx = 1.0
by = -1.0
field_sign = 1.0
field_radius = 0.9
ring_diagnostic = false
ring_history_stride = 1000
ring_checkpoint = false
ring_restart_state = none
<output1>
file_type = log
dt = 0.1
<output2>
file_type = rst
dt = 0.1
