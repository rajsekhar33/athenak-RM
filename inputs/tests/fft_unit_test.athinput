# AthenaK input file for the LocalFFT unit test / benchmark (src/pgen/fft_unit_test.cpp)
# Build: cmake -S . -B build -D PROBLEM=fft_unit_test ...; all work is done in the pgen,
# the run itself stops immediately (nlim = 0).

<comment>
problem   = LocalFFT unit test

<job>
basename  = fft_unit_test

<mesh>
nghost    = 2
nx1       = 8
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 1
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 0
tlim       = 0.0

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
gamma       = 1.6666666666666667

<problem>
nline            = 5             # lines per batch in the correctness tests
tol              = 1.0e-12       # PASS threshold on max relative error
dump             = true          # write <outdir>/fft_N<N>.bin for compare_numpy.py
outdir           = fft_test_out
run_tests        = true
bench            = false         # forward-FFT throughput benchmark
bench_log2_elems = 27            # ~2^bench_log2_elems complex<double> per call
bench_nrep       = 10
