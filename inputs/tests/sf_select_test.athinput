# AthenaK input for the on-the-fly structure-function validation (src/pgen/sf_unit_test.cpp)
# Build: cmake -S . -B build -D PROBLEM=sf_unit_test ...; run stops after the initial
# outputs (nlim = 0). Check with: python3 -I tests/sf/sf_reference.py <run dir>
# One key per line: AthenaK's parser reads a single '=' per line.

<comment>
problem   = sf cell-selection test (select1_*/select2_*; temperature band and density cut)

<job>
basename  = sfsel

<mesh>
nghost    = 2
nx1       = 32
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 32
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 32
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 0
tlim       = 1.0

<hydro>
eos         = ideal
gamma       = 1.6666666666666667
reconstruct = plm
rsolver     = hlle

<problem>
noise     = 1.0
constant  = false
mask      = 0

<output1>
file_type      = sf
id             = scalar
mode           = scalar
variables      = hydro_w_vx, hydro_w_vy, hydro_w_vz
weights        = ones, hydro_w_d
select1_variable = temperature
select1_min    = 0.6
select1_max    = 0.7
max_order      = 3
nbin           = 16
logscale       = true
histogram      = true
hist_nbin      = 16
hist_min       = 1.0e-2
hist_max       = 1.0e1
ndraw_block    = 200000
nsample_global = 16000
nanchor_global = 160000
nreplicate     = 8
seed           = 5
sparse         = true
dt             = 1.0

<output2>
file_type      = sf
id             = longtrans
mode           = long_trans
variables      = hydro_w_vx, hydro_w_vy, hydro_w_vz
weights        = ones
select1_variable = temperature
select1_min    = 0.4
select1_max    = 0.8
select2_variable = hydro_w_d
select2_min    = 1.1
max_order      = 3
nbin           = 16
logscale       = true
ndraw_block    = 200000
nsample_global = 16000
nanchor_global = 160000
nreplicate     = 8
seed           = 6
sparse         = false
dt             = 1.0
