# AthenaK input for the sf aniso_mhd test: sf_unit_test fields with MHD (isothermal),
# nlim = 0. Check with: python3 -I tests/sf/sf_reference.py <run dir>
# One key per line: AthenaK's parser reads a single '=' per line.

<comment>
problem   = sf output unit test

<job>
basename  = sfa

<mesh>
nghost    = 2
nx1       = 16
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 16
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 16
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 0
tlim       = 1.0

<mhd>
eos         = isothermal
iso_sound_speed = 1.0
reconstruct = plm
rsolver     = hlle

<problem>
noise     = 1.0
constant  = false

<output1>
file_type      = sf
id             = aniso
mode           = aniso_mhd
variables      = mhd_w_vx, mhd_w_vy, mhd_w_vz, mhd_bcc1, mhd_bcc2, mhd_bcc3
weights        = ones, mhd_w_d
max_order      = 4
nbin           = 10
nbin_prll      = 8
nbin_perp      = 9
logscale       = true
theta_prll_max = 0.35
theta_perp_min = 1.2
ndraw_block    = 400000
nsample_global = 16000
nanchor_global = 160000
nreplicate     = 8
seed           = 3
timing         = true
dt             = 1.0
