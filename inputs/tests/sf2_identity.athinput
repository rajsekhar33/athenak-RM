# SF2/FFT identity test (tests/sf2_fft_identity.py): sf_unit_test fields, the
# distributed-FFT coefficient dump of the density and an sf output of the density.
# nlim = 0.
# One key per line: AthenaK's parser reads a single '=' per line.

<comment>
problem   = sf output unit test

<job>
basename  = idt

<mesh>
nghost    = 2
nx1       = 16
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 16
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 16
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 0
tlim       = 1.0

<hydro>
eos         = isothermal
iso_sound_speed = 1.0
reconstruct = plm
rsolver     = hlle

<problem>
noise     = 1.0
constant  = false

fft_test       = true
fft_host_stage = false
fft_nrep       = 1
fft_lo1        = 0
fft_hi1        = 16
fft_lo2        = 0
fft_hi2        = 16
fft_lo3        = 0
fft_hi3        = 16
<output1>
file_type      = sf
id             = dens
mode           = scalar
variables      = hydro_w_d
weights        = ones
max_order      = 2
nbin           = 12
logscale       = true
ndraw_block    = 400000
nsample_global = 16000
nanchor_global = 160000
nreplicate     = 8
seed           = 5
dt             = 1.0
